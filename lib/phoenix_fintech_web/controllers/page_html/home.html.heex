<Layouts.app
  flash={@flash}
  current_scope={@current_scope}
  current_user={@current_user}
  conn={@conn}
>
  <%= if @current_user do %>
    <div id="home-page" class="space-y-6">
      <section class="grid gap-4 md:grid-cols-3">
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-baseline gap-2">
                <span class="text-sm text-base-content/60">Transfers Created</span>
                <span class="text-xl font-semibold">{@dashboard.activity_chart.total}</span>
              </div>
              <span class="rounded-box bg-primary/10 p-2 text-primary">
                <.icon name="hero-chart-bar" class="size-4" />
              </span>
            </div>
            <.mini_bar_chart points={@dashboard.activity_chart.points} bar_class="bg-primary" />
          </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-baseline gap-2">
                <span class="shrink-0 text-sm text-base-content/60">Spread revenue</span>
                <span
                  :if={@dashboard.spread_revenue.currency_code}
                  class="truncate text-xl font-semibold"
                >
                  {format_currency_amount(
                    @dashboard.spread_revenue.total,
                    @dashboard.spread_revenue.currency_code
                  )}
                </span>
                <span
                  :if={!@dashboard.spread_revenue.currency_code}
                  class="text-xl font-semibold"
                >
                  0
                </span>
              </div>
              <span class="rounded-box bg-info/10 p-2 text-info">
                <.icon name="hero-banknotes" class="size-4" />
              </span>
            </div>
            <.mini_bar_chart
              points={@dashboard.spread_revenue.points}
              bar_class="bg-info"
              value_formatter={
                fn amount ->
                  format_currency_amount(amount, @dashboard.spread_revenue.currency_code || "")
                end
              }
            />
          </div>
        </div>

        <div class="card bg-base-100 shadow-sm">
          <div class="card-body gap-3">
            <div class="flex items-center justify-between gap-3">
              <div class="flex min-w-0 items-baseline gap-2">
                <span class="text-sm text-base-content/60">Completed transfers</span>
                <span class="text-xl font-semibold">{@dashboard.completion_chart.total}</span>
              </div>
              <span class="rounded-box bg-success/10 p-2 text-success">
                <.icon name="hero-check-circle" class="size-4" />
              </span>
            </div>
            <.mini_bar_chart points={@dashboard.completion_chart.points} bar_class="bg-success" />
          </div>
        </div>
      </section>

      <section class="card bg-base-100 shadow-sm">
        <div class="card-body">
          {Phoenix.Component.live_render(
            @conn,
            PhoenixFintechWeb.HomeFxRatesLive,
            id: "home-live-fx-rates"
          )}
        </div>
      </section>

      <section>
        <div class="card bg-base-100 shadow-sm">
          <div class="card-body">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <h2 class="card-title">Transfer pipeline</h2>
                <p class="text-sm text-base-content/60">
                  Current transfer volume by operational stage.
                </p>
              </div>
              <.link navigate={~p"/app/transfers"} class="btn btn-sm btn-outline">View all</.link>
            </div>

            <div class="mt-2 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
              <div :for={stage <- @dashboard.pipeline} class="stat rounded-box bg-base-200">
                <div class="stat-title">{stage.label}</div>
                <div class="stat-value text-2xl">{stage.count}</div>
                <div class="stat-desc">transfers</div>
              </div>
            </div>

            <div class="overflow-x-auto">
              <table class="table table-zebra">
                <thead>
                  <tr>
                    <th>Transfer</th>
                    <th>Parties</th>
                    <th>Status</th>
                    <th class="text-right">Amount</th>
                  </tr>
                </thead>
                <tbody>
                  <tr :if={@dashboard.recent_transfers == []}>
                    <td colspan="4" class="py-10 text-center text-base-content/60">
                      No transfers yet. Create a transfer to start the pipeline.
                    </td>
                  </tr>
                  <tr
                    :for={transfer <- @dashboard.recent_transfers}
                    id={"home-transfer-#{transfer.id}"}
                    phx-click={JS.navigate(~p"/app/transfers/#{transfer.id}")}
                    class="hover cursor-pointer"
                  >
                    <td>
                      <.copy_value id={"home-transfer-#{transfer.id}-copy"} value={transfer.id} />
                    </td>
                    <td>
                      <div class="font-medium">{transfer.originator_party.legal_name}</div>
                      <div class="text-xs text-base-content/60">
                        to {transfer.counterparty_party.legal_name}
                      </div>
                    </td>
                    <td>
                      <span class={transfer_status_badge_classes(transfer.status)}>
                        {transfer_status_label(transfer.status)}
                      </span>
                    </td>
                    <td class="text-right font-medium">
                      {format_currency_amount(
                        transfer.amount_in_originator_currency,
                        transfer.originator_currency_code
                      )}
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>
        </div>
      </section>
    </div>
  <% else %>
    <div id="home-page" class="space-y-6">
      <section class="hero rounded-box bg-base-100 shadow-sm">
        <div class="hero-content flex-col gap-8 p-8 text-center">
          <div class="space-y-4">
            <div class="badge badge-primary badge-soft">Phoenix Fintech</div>
            <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
              Payments ops without spreadsheet chaos.
            </h1>
            <p class="mx-auto max-w-xl text-base-content/70">
              Manage parties, compliance documents, quotes, transfers, and ledger movement from a focused operator workspace.
            </p>
            <div class="flex flex-col justify-center gap-2 sm:flex-row">
              <.link navigate={~p"/users/log_in"} class="btn btn-primary">Sign in</.link>
              <.link navigate={~p"/users/sign_up"} class="btn btn-ghost">Create account</.link>
            </div>
          </div>

          <div class="stats stats-vertical w-full max-w-lg bg-base-200 shadow sm:stats-horizontal">
            <div class="stat">
              <div class="stat-title">Corridors</div>
              <div class="stat-value">12</div>
              <div class="stat-desc">FX-ready routes</div>
            </div>
            <div class="stat">
              <div class="stat-title">Uptime</div>
              <div class="stat-value text-primary">99.9%</div>
              <div class="stat-desc">Sample target</div>
            </div>
          </div>
        </div>
      </section>
    </div>
  <% end %>
</Layouts.app>
